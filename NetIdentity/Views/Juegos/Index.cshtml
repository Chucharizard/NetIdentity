@{
    ViewData["Title"] = "Juegos";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4">🎮 Centro de Juegos</h1>
            <p class="lead">¡Bienvenido al área de juegos para menores!</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">👦 Solo para Menores Masculinos</h5>
                </div>
                <div class="card-body">
                    <h3 class="card-title">🧠 Juegos Educativos</h3>
                    <p class="card-text">
                        Aprende mientras te diviertes con nuestros juegos educativos diseñados
                        especialmente para desarrollar tus habilidades.
                    </p>
                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item">✓ Matemáticas divertidas</li>
                        <li class="list-group-item">✓ Ortografía y gramática</li>
                        <li class="list-group-item">✓ Ciencias naturales</li>
                    </ul>
                    
                    <div class="alert alert-info mb-3">
                        <strong>📋 Requisitos:</strong>
                        <ul class="mb-0">
                            <li>✓ Menor de 18 años</li>
                            <li>✓ Genero: Masculino</li>
                        </ul>
                    </div>
                    
                    <a asp-action="JuegoEducativo" class="btn btn-primary w-100">Jugar Ahora</a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">👧 Solo para Menores Femeninos</h5>
                </div>
                <div class="card-body">
                    <h3 class="card-title">🏃 Aventuras</h3>
                    <p class="card-text">
                        Embárcate en emocionantes aventuras seguras y apropiadas para tu edad.
                        ¡Explora mundos fantásticos!
                    </p>
                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item">✓ Exploración espacial</li>
                        <li class="list-group-item">✓ Búsqueda del tesoro</li>
                        <li class="list-group-item">✓ Misiones ecológicas</li>
                    </ul>
                    
                    <div class="alert alert-info mb-3">
                        <strong>📋 Requisitos:</strong>
                        <ul class="mb-0">
                            <li>✓ Menor de 18 años</li>
                            <li>✓ Genero: Femenino</li>
                        </ul>
                    </div>
                    
                    <a asp-action="Aventuras" class="btn btn-success w-100">Comenzar Aventura</a>
                </div>
            </div>
        </div>
    </div>

</div>
